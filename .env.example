# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# --- AI provider --------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SARAS_LLM_PROVIDER=openai

# --- External services ----------------------------------------------
NEWS_API_KEY=
SARAS_NEWS_COUNTRY=in

# --- Voice ------------------------------------------------------------
SARAS_WAKE_WORD=Saras
SARAS_TTS_ENGINE=pyttsx3
SARAS_VOICE_RATE=180
SARAS_LISTEN_TIMEOUT=4

# --- Preferences ---------------------------------------------------------
SARAS_DEFAULT_BROWSER=
SARAS_DEFAULT_EDITOR=code
SARAS_DEFAULT_WORKSPACE=

# --- Security -------------------------------------------------------------
# Semicolon-separated absolute paths the terminal tool is allowed to run in.
# Leave empty to default to the user's home directory only.
SARAS_TERMINAL_ALLOWED_ROOTS=
SARAS_CONFIRM_DELETE=true

# --- Storage / logging -----------------------------------------------------
SARAS_DATA_DIR=
SARAS_LOG_LEVEL=INFO
